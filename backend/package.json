{
    "name": "chat-backend",
    "version": "1.0.0",
    "description": "Backend API for Premium Telegram Login App",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "dev": "node --watch server.js",
        "start": "node server.js",
        "postinstall": "npx prisma generate",
        "db:push": "npx prisma db push",
        "db:seed": "node prisma/seed.js",
        "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
        "db:wipe": "npx prisma db push --force-reset",
        "db:setup": "npx prisma db push && node prisma/seed.js",
        "db:studio": "npx prisma studio"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^6.6.0",
        "axios": "^1.13.5",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^1.41.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "form-data": "^4.0.5",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^8.0.1",
        "pdfkit": "^0.17.2",
        "razorpay": "^2.9.6",
        "socket.io": "^4.7.2",
        "streamifier": "^0.1.1"
    },
    "devDependencies": {
        "prisma": "^6.6.0"
    }
}
