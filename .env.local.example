# Development Environment File (.env.local - for local development only)
# Copy .env.example to .env and update values
# For quick local development testing, use these placeholders:

NODE_ENV=development
PORT=5000

# Database - Docker PostgreSQL on host machine
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/krovaa_chat
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=krovaa_chat

# JWT - Use any secret for development
JWT_SECRET=dev_secret_key_only_change_in_production

# Email - Zoho SMTP credentials
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=465
EMAIL_USER=your_email@zoho.com
EMAIL_PASS=your_app_specific_password

# Cloudinary - Your development project
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Razorpay - Test mode credentials
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
VITE_TELEGRAM_BOT_NAME=your_bot_username

# PGAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin_password_dev
