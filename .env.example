# Root Environment File - Served to Backend via PM2 and Docker
# Reference: /documentation/configuration.md
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ========== SERVER CONFIGURATION ==========
NODE_ENV=production
PORT=5000

# ========== DATABASE CONFIGURATION ==========
# Connection string for PostgreSQL (used by backend and Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/krovaa_chat
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=krovaa_chat

# ========== AUTHENTICATION ==========
# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_key_here_change_in_production_min_32_chars

# ========== EMAIL SERVICE (SMTP) ==========
# Used by emailService.js for notifications and password resets
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=465
EMAIL_USER=your_email@zoho.com
EMAIL_PASS=your_app_specific_password

# ========== CLOUDINARY (Image/File Upload) ==========
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========== TELEGRAM (Bot Login & Notifications) ==========
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ========== RAZORPAY (Payments) ==========
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ========== FRONTEND CONFIGURATION ==========
# Base URL for the frontend (for CORS and redirects)
FRONTEND_URL=https://krovaa.com
VITE_API_URL=https://krovaa.com/api
VITE_TELEGRAM_BOT_NAME=your_bot_username

# ========== PGADMIN (Optional - for database management) ==========
PGADMIN_DEFAULT_EMAIL=admin@krovaa.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
